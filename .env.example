OWNER_HANDLE=            # your iPhone's number or Apple ID email (the phone you text FROM); the only sender the agent accepts
LLM_PROVIDER=openai      # openai | bedrock | anthropic | fake
OPENAI_API_KEY=          # cloud planner (T2) when LLM_PROVIDER=openai
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=low
AWS_BEARER_TOKEN_BEDROCK=   # Bedrock API key (cloud planner T2 only)
AWS_REGION=us-west-1        # MUST match the region the Bedrock API key was issued in (else HTTP 403)
BEDROCK_MODEL_ID=us.zai.glm-5.3   # in-region not supported for GLM 5.3; use the us. (or global.) inference profile
ANTHROPIC_API_KEY=       # only if LLM_PROVIDER=anthropic
PLAID_CLIENT_ID=
PLAID_SECRET=
DATA_SOURCE=fixture      # fixture | plaid
MAIL_SOURCE=fixture      # fixture | applemail
CONSENT_TIMEOUT_MS=120000
VOICE=device             # device: on-device model phrases local replies (placeholders only) | plain: fixed templates
